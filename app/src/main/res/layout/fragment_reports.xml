<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reports &amp; Analytics"
            android:textColor="#172554"
            android:textSize="25sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TENANT SUMMARY"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Registered Tenants"
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/totalTenantsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#172554"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RENTAL INCOME SUMMARY"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Monthly Rent"
            android:textColor="#334155"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/totalRentTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KSh 0.00"
            android:textColor="#15803D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AVERAGE RENT PER TENANT"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/averageRentTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KSh 0.00"
            android:textColor="#172554"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CBD5E1"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TENANT DIRECTORY"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tenantReportTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No tenant records available."
            android:textColor="#334155"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/exportPdfButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPORT REPORT AS PDF"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D4ED8"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>