<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/welcomeTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tenant Management Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/overviewTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Overview"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeTextView"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tenantCountTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tenants\n0"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E3F2FD"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/overviewTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/totalRentTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Total rent\nKSh 0"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E8F5E9"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tenantCountTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/addTenantButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ADD TENANT"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@id/totalRentTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/viewTenantsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="VIEW TENANTS"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/addTenantButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>