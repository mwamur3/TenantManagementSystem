<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="tenant"
            type="com.example.tenantmanagmentsystem.Tenant" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <TextView
            android:id="@+id/newTenantLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recently Added Tenant"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/newTenantTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{tenant != null ? tenant.summary() : `No recent tenant`}"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/newTenantLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/callButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALL TENANT"
            app:layout_constraintTop_toBottomOf="@id/newTenantTextView"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/newTenantGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="newTenantLabel,newTenantTextView,callButton" />

        <TextView
            android:id="@+id/allTenantsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Tenants"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/callButton"
            app:layout_constraintStart_toStartOf="parent" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/allTenantsLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/allTenantsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No tenants yet."
                android:padding="8dp" />

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>